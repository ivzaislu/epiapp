# EpiApp server environment
#
# Docker Compose: copy this file to .env in the repository root.
# systemd installer: install.sh copies it to /etc/epiapp/epiapp.env on first install.
# Never commit a production .env containing real secrets.

# Required. Bot token created with @BotFather.
TELEGRAM_BOT_TOKEN=

# Required. Numeric Telegram user ID of the bootstrap administrator.
TELEGRAM_ADMIN_ID=

# Public HTTPS origin of this EpiApp instance. No trailing path.
# On Northflank, leave unset to use the first generated hostname in NF_HOSTS.
# Must be the same server users enter in the universal Android APK.
APP_BASE_URL=https://epiapp.example.com

# Docker Compose/Caddy only: DNS name pointing to this server.
# Usually this is APP_BASE_URL without https://
APP_DOMAIN=epiapp.example.com

# Native/systemd defaults. Docker Compose overrides HOST and DATA_FILE internally.
HOST=127.0.0.1
PORT=3000
DATA_FILE=/var/lib/epiapp/epiapp.json

# Optional PostgreSQL state backend. If either variable is set, PostgreSQL
# replaces DATA_FILE as the durable EpiApp store. DATABASE_URL takes priority.
# Northflank can inject one of these from a PostgreSQL addon secret.
DATABASE_URL=
# POSTGRES_URI=
# Set to 1 on Northflank so a missing URI prevents startup.
# EPIAPP_REQUIRE_POSTGRES=1

# Optional HTTPS URL of the APK distributed by Telegram (/download).
# Empty uses the verified v0.7.4-debug GitHub release. Set a new immutable
# release URL when publishing a new APK; the bot caches Telegram file IDs by URL.
ANDROID_APK_URL=

# Optional Firebase service account JSON, stored as a secret in Northflank.
# Leave unset to keep polling-only delivery. Never put a real key in this file.
# FIREBASE_SERVICE_ACCOUNT_JSON=
