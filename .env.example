# EpiApp server environment
#
# Docker Compose: copy this file to .env in the repository root.
# systemd installer: install.sh copies it to /etc/epiapp/epiapp.env on first install.
# Never commit a production .env containing real secrets.

# Required. Bot token created with @BotFather.
TELEGRAM_BOT_TOKEN=

# Required. Numeric Telegram user ID of the bootstrap administrator.
TELEGRAM_ADMIN_ID=

# Required public HTTPS origin of this EpiApp instance. No trailing path.
# Must be the same server users enter in the universal Android APK.
APP_BASE_URL=https://epiapp.example.com

# Docker Compose/Caddy only: DNS name pointing to this server.
# Usually this is APP_BASE_URL without https://
APP_DOMAIN=epiapp.example.com

# Native/systemd defaults. Docker Compose overrides HOST and DATA_FILE internally.
HOST=127.0.0.1
PORT=3000
DATA_FILE=/var/lib/epiapp/epiapp.json
