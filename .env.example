# EpiApp server environment
# Copy to /etc/epiapp/epiapp.env when installing manually.

# Required for access to /parent. install.sh generates a random 6-digit PIN
# on the first installation if this value is still "change-me".
PARENT_PIN=change-me

# Optional. Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# HTTP port used by the Node.js server.
PORT=3000

# Persistent medication check-in data. The systemd installer creates this directory.
DATA_FILE=/var/lib/epiapp/epiapp.json
