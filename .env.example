# EpiApp server environment
# install.sh creates /etc/epiapp/epiapp.env on first installation.

# Required. Bot token from @BotFather. The same bot authenticates Mini App users
# and sends medication check-in notifications.
TELEGRAM_BOT_TOKEN=

# Required. Numeric Telegram user ID of the bootstrap administrator.
# This account is always an admin and can create/revoke family invitations.
TELEGRAM_ADMIN_ID=

# Public HTTPS address opened by the Telegram bot.
APP_BASE_URL=https://epiapp.duckdns.org

# The Node.js server should stay private behind Nginx.
HOST=127.0.0.1
PORT=3000

# Persistent medication check-in and access-control data.
DATA_FILE=/var/lib/epiapp/epiapp.json
